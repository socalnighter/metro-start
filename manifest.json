{
  "manifest_version": 3,
  "name": "Metro Start",
  "version": "1.16.0",
  "description": "A tile Start screen inspired by Windows 8 for your new tab: folders, bookmark import, widgets, wallpapers and games.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "favicon",
    "geolocation",
    "search"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_permissions": [
    "bookmarks"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
